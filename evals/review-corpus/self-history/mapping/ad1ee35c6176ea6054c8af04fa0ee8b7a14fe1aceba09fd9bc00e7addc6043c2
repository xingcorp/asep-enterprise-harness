--- a/compose.yaml
+++ b/compose.yaml
@@ -1,8 +1,17 @@
 # Local development only. Production must use managed/persistent services,
-# TLS, secret management, network policy and pinned image digests.
+# TLS, secret management and network policy.
+#
+# Image pinning (disp. P2-FINAL-HIGH-001): the two services the integration gate
+# depends on — postgres and minio — are pinned BY DIGEST, not by a mutable tag,
+# and their digests are kept byte-identical to scripts/integration/images.mjs by
+# an executable gate (scripts/integration/run-integration.test.ts). A tag can be
+# re-pointed at new bytes under our feet; a @sha256:<64hex> digest names exactly
+# one immutable manifest, so `pnpm infra:up` and the CI integration job provision
+# the SAME backend build the suites were proven against.
 services:
   postgres:
-    image: postgres:17
+    # postgres:17 — digest-pinned; mirrored in scripts/integration/images.mjs.
+    image: postgres@sha256:a426e44bac0b759c95894d68e1a0ac03ecc20b619f498a91aae373bf06d8508d
     environment:
       POSTGRES_USER: ${POSTGRES_USER}
       POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
@@ -36,7 +45,9 @@ services:
     ports: ["${TEMPORAL_UI_PORT}:8080"]
 
   minio:
-    image: minio/minio:RELEASE.2025-04-22T22-12-26Z
+    # minio RELEASE.2025-04-22T22-12-26Z — digest-pinned; mirrored in
+    # scripts/integration/images.mjs.
+    image: minio/minio@sha256:a1ea29fa28355559ef137d71fc570e508a214ec84ff8083e39bc5428980b015e
     command: server /data --console-address ":9001"
     environment:
       MINIO_ROOT_USER: ${MINIO_ROOT_USER}
@@ -45,6 +56,13 @@ services:
       - "${MINIO_API_PORT}:9000"
       - "${MINIO_CONSOLE_PORT}:9001"
     volumes: ["minio_data:/data"]
+    # Health-checked so `depends_on: service_healthy` and the integration gate
+    # can WAIT for readiness instead of racing it (disp. P2-FINAL-HIGH-001).
+    healthcheck:
+      test: ["CMD-SHELL", "mc ready local || exit 1"]
+      interval: 5s
+      timeout: 3s
+      retries: 20
 
   jaeger:
     image: jaegertracing/all-in-one:1.68.0
