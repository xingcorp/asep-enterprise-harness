// Provider-neutral task-execution use case (exit criteria B1, B4).
//
// This is the SINGLE authority for the Phase-2 execution pipeline. It lives in
// the application layer — NOT in workers/* — so the same use case is callable
// from the CLI, the current worker, and (Phase 3) a Temporal activity. It has
// NO provider SDK, Fastify, pg, Octokit, AWS or Docker import: it composes only
// against @asep/ports interfaces and @asep/policy / @asep/domain pure logic.
//
// The pipeline is decomposed into individually idempotent, resumable STEP use
// cases (disp. XXXXXXXXXXXXXXX / exit B4). Each step:
//   - takes the harness-owned TenantScope + attempt identity,
//   - is a pure orchestration over ports (no hidden state),
//   - returns a serialisable step result,
// so a Temporal-shaped workflow can drive them at activity granularity and a
// crash between steps resumes without replaying a completed side effect.
//
// Trust rules enforced here:
//   - risk admission runs FIRST, before any workspace/agent/push side effect;
//   - the provider result is an UNTRUSTED observation — resultSha/changedFiles
//     come from the trusted GitChangeInspector, never the provider;
//   - the harness owns the commit; the pipeline stops at WAITING_FOR_HUMAN_REVIEW
//     (it never advances a Task to ACCEPTED/DONE — domain invariant I2).

import type {
  RiskLevel,
  TenantScope,
  AttemptId,
  ArtifactRef,
  Budget,
} from '@asep/contracts';
import type {
  CodingAgentProvider,
  AgentAttemptObservation,
  WorkspaceCapability,
  ToolPolicyProfile,
  GitChangeInspector,
  GitChangeObservation,
} from '@asep/ports';
import { admitRisk, type AdmissionResult } from './risk-admission.js';

// ---------------------------------------------------------------------------
// Step boundary types (all serialisable — no live handles leak across a step).
// ---------------------------------------------------------------------------

export type StepStatus = 'OK' | 'STOP';

export interface AdmissionStepResult {
  readonly step: 'admission';
  readonly status: StepStatus;
  readonly admission: AdmissionResult;
}

export interface AgentStepResult {
  readonly step: 'agent';
  readonly status: StepStatus;
  readonly observation: AgentAttemptObservation;
}

export interface InspectStepResult {
  readonly step: 'inspect';
  readonly status: StepStatus;
  // Harness-derived, trusted facts (NOT provider-reported).
  readonly change: GitChangeObservation;
}

// ---------------------------------------------------------------------------
// Step 1 — risk admission (fails closed before any side effect).
// ---------------------------------------------------------------------------

export function admissionStep(risk: RiskLevel): AdmissionStepResult {
  const admission = admitRisk(risk);
  return {
    step: 'admission',
    status: admission.admitted ? 'OK' : 'STOP',
    admission,
  };
}

// ---------------------------------------------------------------------------
// Step 2 — agent invocation (untrusted self-report only).
// ---------------------------------------------------------------------------

export interface AgentStepInput {
  readonly provider: CodingAgentProvider;
  readonly attemptId: AttemptId;
  readonly workOrderRef: ArtifactRef;
  readonly contextPackRef: ArtifactRef;
  readonly workspace: WorkspaceCapability;
  readonly budget: Budget;
  readonly toolPolicy: ToolPolicyProfile;
  readonly signal: AbortSignal;
}

export async function agentStep(input: AgentStepInput): Promise<AgentStepResult> {
  const observation = await input.provider.execute({
    attemptId: input.attemptId,
    workOrderRef: input.workOrderRef,
    contextPackRef: input.contextPackRef,
    workspace: input.workspace,
    budget: input.budget,
    toolPolicy: input.toolPolicy,
    signal: input.signal,
  });
  // AGENT_DONE is the only status that continues the pipeline; anything else
  // (FAILED/BLOCKED/BUDGET_EXHAUSTED) stops it. The provider CANNOT report
  // success of the overall task — only that its own turn finished.
  return {
    step: 'agent',
    status: observation.status === 'AGENT_DONE' ? 'OK' : 'STOP',
    observation,
  };
}

// ---------------------------------------------------------------------------
// Step 3 — trusted Git inspection (derives resultSha/changedFiles).
// ---------------------------------------------------------------------------

export interface InspectStepInput {
  readonly inspector: GitChangeInspector;
  readonly scope: TenantScope;
  readonly workspace: WorkspaceCapability;
}

export async function inspectStep(input: InspectStepInput): Promise<InspectStepResult> {
  const change = await input.inspector.inspect(input.scope, input.workspace);
  // An agent that created its own commit or touched .git is a policy violation:
  // the harness owns commit identity. Stop the pipeline (the caller classifies
  // it as policy-violation per §18) rather than trust the mutated state.
  // XXXXXXXX: a detached-HEAD commit advances HEAD without creating a ref, so
  // createdRefs stays empty and touchedGitDir stays false. headMovedFromBase is
  // the trusted signal for that case — the harness owns commit identity, so ANY
  // HEAD movement observed before the harness's own commit step is an overstep.
  const agentOverstepped =
    change.touchedGitDir || change.createdRefs.length > 0 || change.headMovedFromBase;
  return {
    step: 'inspect',
    status: agentOverstepped ? 'STOP' : 'OK',
    change,
  };
}

// ---------------------------------------------------------------------------
// Whole-pipeline convenience composition (used by the CLI / worker driver and
// the Temporal-shaped fake in tests). Each step is still independently callable
// so a durable workflow can checkpoint between them.
// ---------------------------------------------------------------------------

export interface ExecuteTaskInput {
  readonly scope: TenantScope;
  readonly risk: RiskLevel;
  readonly agent: AgentStepInput;
  readonly inspector: GitChangeInspector;
}

export interface ExecuteTaskResult {
  readonly admitted: boolean;
  readonly reachedInspection: boolean;
  readonly admission: AdmissionResult;
  readonly observation?: AgentAttemptObservation;
  readonly change?: GitChangeObservation;
  readonly stoppedAt: 'admission' | 'agent' | 'inspect' | 'complete';
  readonly requiresHumanIndependentReview: boolean;
}

export async function executeTask(input: ExecuteTaskInput): Promise<ExecuteTaskResult> {
  const admission = admissionStep(input.risk);
  if (admission.status === 'STOP') {
    return {
      admitted: false,
      reachedInspection: false,
      admission: admission.admission,
      stoppedAt: 'admission',
      requiresHumanIndependentReview: admission.admission.requiresHumanIndependentReview,
    };
  }

  const agent = await agentStep(input.agent);
  if (agent.status === 'STOP') {
    return {
      admitted: true,
      reachedInspection: false,
      admission: admission.admission,
      observation: agent.observation,
      stoppedAt: 'agent',
      requiresHumanIndependentReview: admission.admission.requiresHumanIndependentReview,
    };
  }

  const inspect = await inspectStep({
    inspector: input.inspector,
    scope: input.scope,
    workspace: input.agent.workspace,
  });

  return {
    admitted: true,
    reachedInspection: true,
    admission: admission.admission,
    observation: agent.observation,
    change: inspect.change,
    stoppedAt: inspect.status === 'STOP' ? 'inspect' : 'complete',
    requiresHumanIndependentReview: admission.admission.requiresHumanIndependentReview,
  };
}
