{
  "name": "asep-enterprise-harness",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @asep/control-plane-api dev",
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "tsx --test packages/**/*.test.ts apps/**/*.test.ts workers/**/*.test.ts adapters/**/*.test.ts",
    "verify": "pnpm typecheck && pnpm test",
    "infra:up": "docker compose --env-file .env up -d",
    "infra:down": "docker compose --env-file .env down",
    "infra:logs": "docker compose --env-file .env logs -f --tail=200"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
