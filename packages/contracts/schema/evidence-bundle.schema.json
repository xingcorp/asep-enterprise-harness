{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asep.dev/schema/evidence-bundle/v1",
  "version": "1.0.0",
  "title": "EvidenceBundle",
  "description": "Trusted-runner evidence for one attempt. Raw stdout/stderr are captured before any reducer and referenced by artifact id, never embedded.",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskId", "attemptId", "baseSha", "resultSha", "environment", "diff", "checks", "createdAt"],
  "properties": {
    "taskId": { "type": "string", "minLength": 1, "x-tsType": "TaskId" },
    "attemptId": { "type": "string", "minLength": 1, "x-tsType": "AttemptId" },
    "baseSha": { "type": "string", "minLength": 1 },
    "resultSha": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imageDigest", "lockfileHash"],
      "properties": {
        "imageDigest": { "type": "string", "minLength": 1 },
        "lockfileHash": { "type": "string", "minLength": 1 },
        "nodeVersion": { "type": "string" }
      }
    },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "sha256"],
      "properties": {
        "artifactId": { "type": "string", "minLength": 1, "x-tsType": "ArtifactId" },
        "sha256": { "type": "string", "minLength": 1 }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "command", "exitCode", "durationMs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "enum": ["workspace", "static", "unit", "integration", "architecture", "security", "acceptance", "nonfunctional", "review", "release"] },
          "command": { "type": "string", "minLength": 1 },
          "exitCode": { "type": "integer" },
          "durationMs": { "type": "number", "minimum": 0 },
          "stdoutArtifactId": { "type": "string", "x-tsType": "ArtifactId" },
          "stderrArtifactId": { "type": "string", "x-tsType": "ArtifactId" }
        }
      }
    }
  },
  "examples": [
    {
      "taskId": "task-example",
      "attemptId": "attempt-example",
      "baseSha": "0000000000000000000000000000000000000000",
      "resultSha": "1111111111111111111111111111111111111111",
      "createdAt": "2026-07-14T00:00:00Z",
      "environment": { "imageDigest": "sha256:abc", "lockfileHash": "sha256:def" },
      "diff": { "artifactId": "artifact-diff", "sha256": "sha256:diff" },
      "checks": [
        { "id": "typecheck", "category": "static", "command": "pnpm typecheck", "exitCode": 0, "durationMs": 1000, "stdoutArtifactId": "artifact-out", "stderrArtifactId": "artifact-err" }
      ]
    }
  ]
}
