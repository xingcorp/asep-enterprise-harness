{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asep.dev/schema/architecture-invariant/v1",
  "version": "1.0.0",
  "title": "ArchitectureInvariant",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "statement", "category"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "statement": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "enum": ["DEPENDENCY", "LAYERING", "SECURITY", "DATA", "NAMING", "OTHER"] },
    "rationale": { "type": "string" }
  },
  "examples": [
    { "id": "INV-001", "statement": "No provider SDK may be imported by domain contracts.", "category": "DEPENDENCY" }
  ]
}
