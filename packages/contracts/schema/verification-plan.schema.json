{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asep.dev/schema/verification-plan/v1",
  "version": "1.0.0",
  "title": "VerificationPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "workOrderId", "risk", "requiredLevels", "checks"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "workOrderId": { "type": "string", "minLength": 1, "x-tsType": "TaskId" },
    "risk": { "type": "string", "enum": ["R0", "R1", "R2", "R3", "R4"], "x-tsType": "RiskLevel" },
    "requiredLevels": {
      "type": "array",
      "items": { "type": "string", "enum": ["L0", "L1", "L2", "L3", "L4", "L5", "L6", "L7", "L8", "L9"] }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "level", "category", "mandatory"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "level": { "type": "string", "enum": ["L0", "L1", "L2", "L3", "L4", "L5", "L6", "L7", "L8", "L9"] },
          "category": { "type": "string", "enum": ["workspace", "static", "unit", "integration", "architecture", "security", "acceptance", "nonfunctional", "review", "release"] },
          "mandatory": { "type": "boolean" },
          "description": { "type": "string" }
        }
      }
    }
  },
  "examples": [
    {
      "id": "vp-example",
      "workOrderId": "task-example",
      "risk": "R2",
      "requiredLevels": ["L0", "L1", "L2", "L3", "L4", "L5", "L8"],
      "checks": [
        { "id": "chk-workspace", "level": "L0", "category": "workspace", "mandatory": true }
      ]
    }
  ]
}
