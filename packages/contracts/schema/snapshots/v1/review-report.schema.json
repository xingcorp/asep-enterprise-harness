{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asep.dev/schema/review-report/v1",
  "version": "1.0.0",
  "title": "ReviewReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["reviewerProvider", "reviewerModel", "verdict", "findings", "confidence"],
  "properties": {
    "reviewerProvider": { "type": "string", "minLength": 1 },
    "reviewerModel": { "type": "string", "minLength": 1 },
    "verdict": { "type": "string", "enum": ["APPROVE", "REQUEST_CHANGES", "ESCALATE"] },
    "findings": { "type": "array", "items": { "$ref": "https://asep.dev/schema/finding/v1", "x-tsType": "Finding" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "examples": [
    {
      "reviewerProvider": "codex",
      "reviewerModel": "gpt-5.6-sol",
      "verdict": "REQUEST_CHANGES",
      "confidence": 0.9,
      "findings": [
        {
          "id": "REV-001",
          "severity": "HIGH",
          "category": "CORRECTNESS",
          "requirementId": "REQ-001",
          "file": "src/example.ts",
          "lineStart": 10,
          "lineEnd": 20,
          "evidence": "Concrete, reproducible evidence",
          "requiredFix": "Specific expected behavior"
        }
      ]
    }
  ]
}
